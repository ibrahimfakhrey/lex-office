# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=your-secret-key-here
FLASK_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/lexoffice
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/lexoffice_test

# Email (Gmail SMTP with App Password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# JWT
JWT_SECRET_KEY=your-jwt-secret-here

# Redis (for Celery & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# At-rest encryption (REQUIRED on production once Phase 0 lands)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IF LOST: all encrypted tenant data is unrecoverable.
ENCRYPTION_MASTER_KEY=
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_BLIND_INDEX_KEY=
